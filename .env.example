# Copy to .env.local for local dev, and set these in the Vercel dashboard
# (Project -> Settings -> Environment Variables) for production.
#
# IMPORTANT: never prefix a secret with NEXT_PUBLIC_. Next.js inlines those
# into the JavaScript bundle sent to every visitor, so the value is public.

# Shared OpenRouter key, used by /api/chat when the visitor hasn't entered
# their own key. Stays server-side. Recommended: create a dedicated key at
# https://openrouter.ai/settings/keys with a credit limit set on it.
OPENROUTER_API_KEY=

# Model used with the shared key. Must end in ":free" (or be "openrouter/free") unless ALLOW_PAID_MODEL
# is set to true. See https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Safety switch. Leave unset so a mistyped OPENROUTER_MODEL can never spend money.
# ALLOW_PAID_MODEL=true

# Optional. Comma-separated origins allowed to call /api/chat. Leave unset to
# allow any origin (needed for local dev and Vercel preview URLs).
# ALLOWED_ORIGINS=https://chat-vrm-window.vercel.app

# Optional. Sent as HTTP-Referer to OpenRouter for their app rankings.
# SITE_URL=https://chat-vrm-window.vercel.app/
